{
  "name": "pdf-viewer-ui-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Static (non-functional) recreation of the EmbedPDF viewer UI in plain TypeScript, HTML and CSS.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2019 --outfile=dist/app.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
